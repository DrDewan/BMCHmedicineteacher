# Browser-safe Supabase values used by the Next.js/Vercel application
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for privileged application operations. Never expose in browser code.
SUPABASE_SECRET_KEY=

# AI integration
OPENAI_API_KEY=

# Document worker connection used by the Next.js/Vercel application
DOCUMENT_WORKER_URL=
DOCUMENT_WORKER_SECRET=

# The containerised services/document-worker uses its own environment:
# SUPABASE_URL=<same Supabase project URL>
# SUPABASE_SECRET_KEY=<server-only secret/service-role key>
# DOCUMENT_WORKER_SECRET=<same shared secret as above>
# STORAGE_BUCKET=bmch-resources
